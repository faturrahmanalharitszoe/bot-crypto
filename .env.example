# ============================================================
#  Binance Scalping Bot — Environment Configuration
# ============================================================
#  1. Copy this file to .env
#  2. Fill in your keys (Testnet keys from https://testnet.binance.vision)
#  3. Never commit your .env to Git!
# ============================================================

# ── Binance API Credentials ─────────────────────────────────
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# ── Mode ─────────────────────────────────────────────────────
TESTNET=true

# ── Telegram Notifications (optional) ───────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Send a message to your new bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Copy the "id" from the "chat" object
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Web Dashboard ─────────────────────────────────────────────
WEB_DASHBOARD=true
WEB_PORT=5050
